[Unit]
Description=Telegram submission bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bots
WorkingDirectory=/opt/telegram-submission-bot
EnvironmentFile=/etc/telegram-submission-bot.env
ExecStart=/usr/bin/python3 bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
